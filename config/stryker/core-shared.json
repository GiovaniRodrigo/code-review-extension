{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "reporters": [
    "clear-text",
    "html"
  ],
  "coverageAnalysis": "off",
  "mutate": [
    "packages/core/src/shared/**/*.ts",
    "!**/*.test.ts",
    "!**/*.spec.ts",
    "!**/tests/**"
  ],
  "ignorePatterns": [
    ".stryker-tmp/**",
    "coverage/**",
    "mutation-report/**",
    "dist/**",
    "build/**",
    ".vscode-test/**",
    "apps/vscode/.vscode-test/**",
    "apps/vscode/dist/**",
    "apps/vscode/out/**",
    "apps/vscode/**/*.vsix",
    "docs/**"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  },
  "vitest": {
    "configFile": "config/vitest/mutation.core-shared.config.ts"
  },
  "htmlReporter": {
    "fileName": "mutation-report/core-shared/index.html"
  }
}
