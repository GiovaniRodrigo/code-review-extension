{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "reporters": [
    "clear-text",
    "html"
  ],
  "coverageAnalysis": "off",
  "mutate": [
    "packages/domain/src/**/*.ts",
    "packages/core/src/application/use-cases/**/*.ts",
    "packages/core/src/application/services/ai/*.ts",
    "packages/core/src/shared/**/*.ts",
    "packages/analyzers/src/**/*.ts",
    "!**/*.test.ts",
    "!**/*.spec.ts",
    "!**/tests/**",
    "!**/dist/**",
    "!**/coverage/**"
  ],
  "ignorePatterns": [
    ".stryker-tmp/**",
    "coverage/**",
    "mutation-report/**",
    "dist/**",
    "build/**",
    ".vscode-test/**",
    "apps/vscode/.vscode-test/**",
    "apps/vscode/dist/**",
    "apps/vscode/out/**",
    "apps/vscode/**/*.vsix",
    "docs/**"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  },
  "vitest": {
    "configFile": "vitest.unit.config.ts"
  }
}