{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",

  "testRunner": "vitest",

  "reporters": [
    "clear-text",
    "html"
  ],

  "coverageAnalysis": "off",

  "mutate": [
    "packages/domain/src/**/*.ts",
    "packages/application/src/**/*.ts",
    "packages/analyzers/src/**/*.ts",

    "!**/*.test.ts",
    "!**/*.spec.ts",
    "!**/tests/**",
    "!**/dist/**",
    "!**/coverage/**"
  ],

  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },

  "vitest": {
    "configFile": "vitest.unit.config.ts"
  }
}
