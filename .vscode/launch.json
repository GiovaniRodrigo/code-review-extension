{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug VSCode Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode",
        "--disable-extensions"
      ],
      "outFiles": [
        "${workspaceFolder}/apps/vscode/dist/**/*.js"
      ],
      "preLaunchTask": "build:vscode",
      "smartStep": true,
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**",
        "**/github.copilot-chat/**",
        "**/resources/app/**",
        "**/extensions/github.copilot*/**",
        "**/.vscode-test/**"
      ]
    },
    {
      "name": "Extension E2E Tests",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode",
        "--extensionTestsPath=${workspaceFolder}/apps/vscode/tests/e2e/suite/index.cjs",
        "--disable-extensions"
      ],
      "outFiles": [
        "${workspaceFolder}/apps/vscode/dist/**/*.js"
      ],
      "preLaunchTask": "build:vscode",
      "smartStep": true,
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**",
        "**/github.copilot-chat/**",
        "**/resources/app/**",
        "**/extensions/github.copilot*/**",
        "**/.vscode-test/**"
      ]
    }
  ]
}
