{
    "compilerOptions": {
        "outDir": "out",
        "target": "ES2022",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "noImplicitAny": false,
        "types": [
            "node",
            "vscode",
            "mocha"
        ],
        "paths": {
            "@code-review/core": [
                "../../packages/core/src/index.ts"
            ],
            "@code-review/domain": [
                "../../packages/domain/src/index.ts"
            ],
            "@code-review/infra": [
                "../../packages/infra/src/index.ts"
            ],
            "@code-review/ui": [
                "../../packages/ui/src/index.ts"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts"
    ]
}
