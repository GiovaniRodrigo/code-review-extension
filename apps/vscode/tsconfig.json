{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "types": [
            "node",
            "vscode"
        ],
        "paths": {
            "@code-review/core": [
                "../../packages/core/src/runtime.ts"
            ],
            "@code-review/domain": [
                "../../packages/domain/src/index.ts"
            ],
            "@code-review/infra": [
                "../../packages/infra/src/index.ts"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts"
    ]
}