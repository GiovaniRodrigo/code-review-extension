{
  "name": "git-code-review",
  "publisher": "CodeReviewExtension",
  "displayName": "Git Code Review",
  "description": "An Enterprise-ready code review governance workspace for code reviewers inside VS Code, with AI Coding Guard, Git context, Human-in-the-Loop findings, local-first RAG, cloud AI, Team collaboration foundations, SSO/RBAC, audit logs and AI governance.",
  "version": "5.1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/giovani/code-review-extension.git"
  },
  "activationEvents": [
    "onCommand:code-review.startReview",
    "onCommand:code-review.analyze",
    "onCommand:code-review.analyzeBranchCommits",
    "onCommand:code-review.analyzePr",
    "onCommand:code-review.analyzeWorkspace",
    "onCommand:code-review.approveFinding",
    "onCommand:code-review.clearRepositoryRag",
    "onCommand:code-review.clearSession",
    "onCommand:code-review.focus",
    "onCommand:code-review.generatePRSummary",
    "onCommand:code-review.generateQualityReport",
    "onCommand:code-review.indexRepositoryRag",
    "onCommand:code-review.publishPrReview",
    "onCommand:code-review.restoreSession",
    "onCommand:code-review.searchRepositoryContext",
    "onCommand:code-review.setGeminiApiKey",
    "onCommand:code-review.setGitHubToken",
    "onCommand:code-review.setGitLabCredentials",
    "onCommand:code-review.setGitLabToken",
    "onCommand:code-review.setGitLabUrl",
    "onCommand:code-review.setOpenAIApiKey",
    "onCommand:code-review.setProvider",
    "onCommand:code-review.setup",
    "onCommand:code-review.setupRag",
    "onCommand:code-review.syncRemotePR",
    "onCommand:code-review.syncWithVps",
    "onCommand:code-review.runDiagnostics",
    "onStartupFinished",
    "onView:code-review.chatView",
    "onView:code-review.dashboard",
    "onView:code-review.dependencyGraph",
    "onView:code-review.findingsView",
    "onView:code-review.ragStatus",
    "onCommand:code-review.exportMarkdown",
    "onCommand:code-review.setupOllama",
    "onCommand:code-review.revalidateSession",
    "onCommand:code-review.configureCloudProvider",
    "onCommand:code-review.testAIProvider",
    "onCommand:code-review.exportPdf",
    "onCommand:code-review.selectReviewTemplate",
    "onCommand:code-review.showProUpgrade",
    "onCommand:code-review.openReviewHistory",
    "onCommand:code-review.openProviderSetup",
    "onCommand:code-review.openRagManager",
    "onCommand:code-review.openPRSummary",
    "onCommand:code-review.openQualityReport",
    "onCommand:code-review.openReviewIntelligence",
    "onCommand:code-review.openProjectChat",
    "onCommand:code-review.openDependencyGraph",
    "onCommand:code-review.viewPlans",
    "onCommand:code-review.configureLicense",
    "onCommand:code-review.startProTrial",
    "onCommand:code-review.openTeamDashboard",
    "onCommand:code-review.shareReviewSession",
    "onCommand:code-review.manageReviewPolicies",
    "onCommand:code-review.openCollaborationCenter",
    "onCommand:code-review.openEnterpriseGovernance",
    "onCommand:code-review.configureSso",
    "onCommand:code-review.configureRbac",
    "onCommand:code-review.openAuditLogs",
    "onCommand:code-review.exportAuditLogs",
    "onCommand:code-review.configureAIPolicies",
    "onCommand:code-review.prepareSelfHostedBundle",
    "onCommand:code-review.openWorkspace",
    "onCommand:code-review.openAiCodingGuard",
    "onCommand:code-review.openDashboard",
    "onCommand:code-review.runUiRegressionGate",
    "onCommand:code-review.openRagContextExplorer",
    "onCommand:code-review.openReviewSessionTimeline",
    "onCommand:code-review.openProCommercialCenter",
    "onCommand:code-review.openTeamSyncCenter",
    "onCommand:code-review.openEnterpriseReadinessReport",
    "onCommand:code-review.aiCodingGuard.scanActiveDraft",
    "onCommand:code-review.aiCodingGuard.scanChangedFiles",
    "onCommand:code-review.aiCodingGuard.toggleAutoWatch"
  ],
  "scripts": {
    "compile": "tsc -p .",
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --alias:@code-review/core=../../packages/core/src/index.ts --alias:@code-review/domain=../../packages/domain/src/index.ts --alias:@code-review/infra=../../packages/infra/src/index.ts --alias:@code-review/ui=../../packages/ui/src/index.ts --outfile=dist/extension.js",
    "test": "vitest run --config vitest.config.ts --pool=threads",
    "test:watch": "vitest --config vitest.config.ts",
    "test:smoke": "vitest run tests/integration/extension.smoke.test.ts tests/integration/adapters/*.smoke.test.ts --config vitest.config.ts --pool=threads",
    "test:integration": "vitest run tests/integration --config vitest.config.ts",
    "test:regression": "vitest run tests/regression --config vitest.config.ts",
    "test:architecture": "npx dependency-cruiser src",
    "test:e2e": "npm run build && node ./out/apps/vscode/tests/e2e/runTest.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "validate:build": "npx tsx scripts/validate-build.ts",
    "validate:config": "npx tsx scripts/validate-config.ts",
    "quality": "npm run typecheck && npm run test:architecture && npm run validate:config && npm run test:smoke && npm run test:integration",
    "package": "npm run build && vsce package --allow-missing-repository --no-dependencies",
    "publish": "vsce publish",
    "test:production": "vitest run tests/production/package-manifest.test.ts tests/production/ui-regression.test.ts --config vitest.config.ts --coverage.enabled=false --pool=threads",
    "validate:vsix": "node scripts/validate-vsix.cjs",
    "production:gate": "npm run typecheck && npm run test:production && npm run build && npm run package && npm run validate:vsix",
    "marketplace:package": "npm run product:release",
    "marketplace:publish": "vsce publish --packagePath git-code-review-5.1.0.vsix"
  },
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Testing",
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
