    "configuration": {
      "title": "Git Code Review",
      "properties": {
        "codeReview.provider": {
          "type": "string",
          "default": "mock",
          "enum": [
            "mock",
            "ollama",
            "openai",
            "gemini",
            "claude"
          ],
          "description": "AI provider used to analyze code."
        },
        "codeReview.ollama.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL for the local Ollama server."
        },
        "codeReview.ollama.model": {
          "type": "string",
          "default": "llama3",
          "description": "Ollama model used for local code review."
        },
        "codeReview.openai.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "OpenAI model used for code review."
        },
        "codeReview.gemini.model": {
          "type": "string",
          "default": "gemini-flash-latest",
          "description": "Gemini model used for code review."
        },
        "codeReview.ai.providers": {
          "type": "array",
          "default": [],
          "description": "List of configured AI providers."
        },
        "codeReview.ai.activeProviderId": {
          "type": "string",
          "default": "",
          "description": "ID of the currently active AI provider."
        },
        "codeReview.ai.timeout": {
          "type": "number",
          "default": 30000,
          "description": "AI Analysis timeout in milliseconds."
        },
        "codeReview.ai.retries": {
          "type": "number",
          "default": 2,
          "description": "Maximum number of retries for AI analysis."
        },
        "codeReview.rag.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Retrieval Augmented Generation for context enrichment."
        },
        "codeReview.rag.maxChunks": {
          "type": "number",
          "default": 5,
          "description": "Maximum number of code chunks to send as context."
        },
        "codeReview.rag.ignoredFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".git",
            "dist",
            ".turbo"
          ],
          "description": "Folders to ignore during RAG indexing."
        },
        "codeReview.privacy.maskData": {
          "type": "boolean",
          "default": true,
          "description": "Automatically mask PII (emails, IPs) and potential secrets before sending code to AI."
        },
        "codeReview.autoRestoreSession": {
          "type": "boolean",
          "default": true,
          "description": "Automatically restore previous review session when switching branches."
        },
        "codeReview.autoRevalidate": {
          "type": "boolean",
          "default": false,
          "description": "Automatically revalidate code after file save."
        },
        "codeReview.github.token": {
          "type": "string",
          "default": "",
          "description": "GitHub token for PR analysis."
        },
        "codeReview.gitlab.token": {
          "type": "string",
          "default": "",
          "description": "GitLab token for MR analysis."
        },
        "codeReview.gitlab.baseUrl": {
          "type": "string",
          "default": "https://gitlab.com",
          "description": "GitLab instance base URL."
        },
        "codeReview.gitlab.projectId": {
          "type": "string",
          "default": "",
          "description": "GitLab Project ID (numeric or path/to/project)."
        },
        "codeReview.gitlab.username": {
          "type": "string",
          "default": "",
          "description": "GitLab username (for basic auth)."
        },
        "codeReview.git.baseBranch": {
          "type": "string",
          "default": "",
          "description": "Base branch used for branch diff, branch commit analysis, and PR summary generation. Leave empty to auto-detect origin/main, main, origin/master, master, origin/develop, develop, origin/dev, or dev."
        },
        "codeReview.workspace.maxFiles": {
          "type": "number",
          "default": 250,
          "minimum": 1,
          "maximum": 2000,
          "description": "Maximum files analyzed by the workspace analyzer in a single run."
        },
        "codeReview.workspace.includeExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".php",
            ".vue",
            ".ts",
            ".tsx",
            ".js",
            ".jsx",
            ".json",
            ".md",
            ".py",
            ".go",
            ".java",
            ".cs",
            ".rb"
          ],
          "description": "File extensions considered by workspace analysis."
        },
        "codeReview.product.plan": {
          "type": "string",
          "default": "community",
          "enum": [
            "community",
            "pro",
            "team",
            "enterprise"
          ],
          "description": "Current product plan used by the extension UI and diagnostics."
        },
        "codeReview.product.targetAudience": {
          "type": "string",
          "default": "code reviewers",
          "description": "Primary product audience. Used to keep onboarding and UX aligned."
        },
        "codeReview.community.showOnboardingOnStart": {
          "type": "boolean",
          "default": true,
          "description": "Show the first-run Community onboarding prompt once after installation."
        },
        "codeReview.community.autoIndexRagAfterSetup": {
          "type": "boolean",
          "default": false,
          "description": "Offer automatic local RAG indexing after guided setup."
        },
        "codeReview.session.persistLocal": {
          "type": "boolean",
          "default": true,
          "description": "Persist review sessions locally so findings survive VS Code reloads."
        },
        "codeReview.refactor.previewBeforeApply": {
          "type": "boolean",
          "default": true,
          "description": "Always show a diff preview before applying AI-generated refactors."
        },
        "codeReview.review.template": {
          "type": "string",
          "default": "general",
          "enum": [
            "general",
            "security",
            "architecture",
            "laravel",
            "react",
            "api",
            "performance",
            "testability"
          ],
          "description": "Review template used to focus the next analysis."
        },
        "codeReview.pro.cloudProviderConfigured": {
          "type": "boolean",
          "default": false,
          "description": "Indicates whether a Pro cloud provider has been configured in this VS Code profile."
        },
        "codeReview.export.pdf.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable local PDF export for review reports."
        },
        "codeReview.pro.prSummary.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Pro Foundation PR summary workflow."
        },
        "codeReview.team.organization": {
          "type": "string",
          "default": "",
          "description": "Team organization name for shared sessions and dashboards."
        },
        "codeReview.team.sharedSessions.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Team shared-session workflows when a backend is configured."
        },
        "codeReview.enterprise.sso.provider": {
          "type": "string",
          "default": "not configured",
          "enum": [
            "not configured",
            "disabled",
            "saml",
            "oidc"
          ],
          "description": "Enterprise SSO provider mode."
        },
        "codeReview.enterprise.rbac.role": {
          "type": "string",
          "default": "reviewer",
          "enum": [
            "admin",
            "reviewer",
            "viewer"
          ],
          "description": "Local RBAC role used by Enterprise governance workflows."
        },
        "codeReview.enterprise.audit.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable local audit logs for governance actions."
        },
        "codeReview.enterprise.ai.localOnly": {
          "type": "boolean",
          "default": false,
          "description": "Restrict AI usage to local providers only."
        },
        "codeReview.enterprise.selfHosted.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable self-hosted readiness workflows."
        },
        "codeReview.product.trial.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Allow local Pro trial activation for evaluation."
        },
        "codeReview.rag.incremental.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable incremental local RAG reindexing for changed files."
        },
        "codeReview.session.timeline.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show local review session timeline in the workspace."
        },
        "codeReview.team.sync.mode": {
          "type": "string",
          "default": "local-export",
          "enum": [
            "local-export",
            "cloud-sync"
          ],
          "description": "Team sync mode. Cloud sync requires backend."
        },
        "codeReview.aiCodingGuard.autoWatch.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan changed/open documents for generated-code nonconformities."
        },
        "codeReview.aiCodingGuard.autoWatch.notify": {
          "type": "boolean",
          "default": true,
          "description": "Show a warning notification when AI Coding Guard Auto Watch finds blocked or warning issues."
        },
        "codeReview.aiCodingGuard.autoWatch.scanUnsaved": {
          "type": "boolean",
          "default": true,
          "description": "Scan unsaved active document changes while another AI agent is drafting code."
        },
        "codeReview.aiCodingGuard.autoWatch.scanActiveEditor": {
          "type": "boolean",
          "default": true,
          "description": "Scan the active editor when focus changes so generated draft previews are checked automatically."
        },
        "codeReview.aiCodingGuard.autoWatch.maxChars": {
          "type": "number",
          "default": 180000,
          "minimum": 1000,
          "maximum": 1000000,
          "description": "Maximum document size scanned by AI Coding Guard Auto Watch."
        }
      }
    },
