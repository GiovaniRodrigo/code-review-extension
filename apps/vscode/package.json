{
  "name": "vscode-code-review",
  "displayName": "AI Code Review",
  "description": "AI-assisted Code Review Extension",
  "version": "2.0.0",
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --alias:@code-review/core=../../packages/core/src/runtime.ts --alias:@code-review/domain=../../packages/domain/src/index.ts --alias:@code-review/infra=../../packages/infra/src/index.ts --outfile=dist/extension.js",
    "package": "npm run build && vsce package --allow-missing-repository",
    "publish": "vsce publish"
  },
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "code-review.analyze",
        "title": "Code Review: Analyze Code with IA"
      },
      {
        "command": "code-review.analyzeBranchCommits",
        "title": "Code Review: Analyze Branch Commits"
      },
      {
        "command": "code-review.clearSession",
        "title": "Code Review: Clear Current Review Session"
      },
      {
        "command": "code-review.setOpenAIApiKey",
        "title": "Code Review: Set OpenAI API Key"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-review",
          "title": "AI Review",
          "icon": "$(search-stop)"
        }
      ]
    },
    "views": {
      "code-review": [
        {
          "type": "webview",
          "id": "code-review.findingsView",
          "name": "Findings"
        }
      ]
    },
    "configuration": {
      "title": "AI Code Review",
      "properties": {
        "codeReview.provider": {
          "type": "string",
          "default": "mock",
          "enum": [
            "mock",
            "ollama",
            "openai"
          ],
          "description": "AI provider used to analyze code."
        },
        "codeReview.ollama.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL for the local Ollama server."
        },
        "codeReview.ollama.model": {
          "type": "string",
          "default": "llama3",
          "description": "Ollama model used for local code review."
        },
        "codeReview.openai.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "OpenAI model used for code review."
        }
      }
    }
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.7.0",
    "@types/vscode": "^1.118.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "mocha": "^11.7.5",
    "typescript": "^5.9.3",
    "vscode": "^1.1.37"
  }
}