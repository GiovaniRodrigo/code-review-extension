{
  "name": "git-code-review",
  "publisher": "CodeReviewExtension",
  "displayName": "AI Code Review (Beta)",
  "description": "Intelligent Code Review with Human-in-the-Loop, RAG support, and multi-provider IA (Ollama/OpenAI).",
  "version": "2.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/giovani/code-review-extension.git"
  },
  "scripts": {
    "compile": "tsc -p .",
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --alias:@code-review/core=../../packages/core/src/index.ts --alias:@code-review/domain=../../packages/domain/src/index.ts --alias:@code-review/infra=../../packages/infra/src/index.ts --outfile=dist/extension.js",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "npm run build && node ./out/apps/vscode/tests/e2e/runTest.js",
    "package": "npm run build && vsce package --allow-missing-repository",
    "publish": "vsce publish"
  },
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "code-review.analyze",
        "title": "Code Review: Analyze Code with IA"
      },
      {
        "command": "code-review.analyzeWorkspace",
        "title": "Code Review: Analyze Entire Workspace"
      },
      {
        "command": "code-review.generatePRSummary",
        "title": "Code Review: Generate AI PR Summary"
      },
      {
        "command": "code-review.generateQualityReport",
        "title": "Code Review: Generate Technical Quality Report"
      },
      {
        "command": "code-review.analyzeBranchCommits",
        "title": "Code Review: Analyze Branch Commits"
      },
      {
        "command": "code-review.analyzePr",
        "title": "Code Review: Analyze Pull Request"
      },
      {
        "command": "code-review.clearRepositoryRag",
        "title": "Code Review: Clear Repository RAG"
      },
      {
        "command": "code-review.clearSession",
        "title": "Code Review: Clear Current Review Session"
      },
      {
        "command": "code-review.focus",
        "title": "Code Review: Focus on AI Review View"
      },
      {
        "command": "code-review.indexRepositoryRag",
        "title": "Code Review: Index Repository RAG"
      },
      {
        "command": "code-review.publishPrReview",
        "title": "Code Review: Publish Approved Findings to PR/MR"
      },
      {
        "command": "code-review.restoreSession",
        "title": "Code Review: Restore Session for Current Branch"
      },
      {
        "command": "code-review.searchRepositoryContext",
        "title": "Code Review: Search Repository Context"
      },
      {
        "command": "code-review.setGitLabCredentials",
        "title": "Code Review: Set GitLab Login/Password"
      },
      {
        "command": "code-review.setGitLabToken",
        "title": "Code Review: Set GitLab Private Token"
      },
      {
        "command": "code-review.setGitLabUrl",
        "title": "Code Review: Set GitLab Base URL"
      },
      {
        "command": "code-review.setOpenAIApiKey",
        "title": "Code Review: Set OpenAI API Key"
      },
      {
        "command": "code-review.setGeminiApiKey",
        "title": "Code Review: Set Gemini API Key"
      },
      {
        "command": "code-review.setProvider",
        "title": "Code Review: Set AI Provider"
      },
      {
        "command": "code-review.syncRemotePR",
        "title": "Code Review: Sync with GitHub/GitLab PR/MR"
      },
      {
        "command": "code-review.setupRag",
        "title": "Code Review: Setup RAG"
      },
      {
        "command": "code-review.setup",
        "title": "Code Review: Guided Setup"
      },
      {
        "command": "code-review.approveFinding",
        "title": "Code Review: Approve Finding"
      },
      {
        "command": "code-review.syncWithVps",
        "title": "Code Review: Sync with VPS"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-review",
          "title": "AI Review",
          "icon": "$(search-stop)"
        }
      ]
    },
    "views": {
      "code-review": [
        {
          "type": "webview",
          "id": "code-review.dashboard",
          "name": "Dashboard"
        },
        {
          "type": "webview",
          "id": "code-review.findingsView",
          "name": "Review Findings"
        },
        {
          "type": "webview",
          "id": "code-review.chatView",
          "name": "Project AI Chat"
        },
        {
          "type": "webview",
          "id": "code-review.ragStatus",
          "name": "RAG Status"
        },
        {
          "type": "webview",
          "id": "code-review.dependencyGraph",
          "name": "Dependency Graph"
        }
      ]
    },
    "keybindings": [
      {
        "command": "code-review.analyze",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus"
      },
      {
        "command": "code-review.focus",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v"
      }
    ],
    "configuration": {
      "title": "AI Code Review",
      "properties": {
        "codeReview.provider": {
          "type": "string",
          "default": "mock",
          "enum": [
            "mock",
            "ollama",
            "openai",
            "gemini",
            "claude"
          ],
          "description": "AI provider used to analyze code."
        },
        "codeReview.ollama.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL for the local Ollama server."
        },
        "codeReview.ollama.model": {
          "type": "string",
          "default": "llama3",
          "description": "Ollama model used for local code review."
        },
        "codeReview.openai.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "OpenAI model used for code review."
        },
        "codeReview.gemini.model": {
          "type": "string",
          "default": "gemini-flash-latest",
          "description": "Gemini model used for code review."
        },
        "codeReview.ai.providers": {
          "type": "array",
          "default": [],
          "description": "List of configured AI providers."
        },
        "codeReview.ai.activeProviderId": {
          "type": "string",
          "default": "",
          "description": "ID of the currently active AI provider."
        },
        "codeReview.ai.timeout": {
          "type": "number",
          "default": 30000,
          "description": "AI Analysis timeout in milliseconds."
        },
        "codeReview.ai.retries": {
          "type": "number",
          "default": 2,
          "description": "Maximum number of retries for AI analysis."
        },
        "codeReview.rag.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Retrieval Augmented Generation for context enrichment."
        },
        "codeReview.rag.maxChunks": {
          "type": "number",
          "default": 5,
          "description": "Maximum number of code chunks to send as context."
        },
        "codeReview.rag.ignoredFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".git",
            "dist",
            ".turbo"
          ],
          "description": "Folders to ignore during RAG indexing."
        },
        "codeReview.privacy.maskData": {
          "type": "boolean",
          "default": true,
          "description": "Automatically mask PII (emails, IPs) and potential secrets before sending code to AI."
        },
        "codeReview.autoRestoreSession": {
          "type": "boolean",
          "default": true,
          "description": "Automatically restore previous review session when switching branches."
        },
        "codeReview.autoRevalidate": {
          "type": "boolean",
          "default": false,
          "description": "Automatically revalidate code after file save."
        },
        "codeReview.github.token": {
          "type": "string",
          "default": "",
          "description": "GitHub token for PR analysis."
        },
        "codeReview.gitlab.token": {
          "type": "string",
          "default": "",
          "description": "GitLab token for MR analysis."
        },
        "codeReview.gitlab.baseUrl": {
          "type": "string",
          "default": "https://gitlab.com",
          "description": "GitLab instance base URL."
        },
        "codeReview.gitlab.projectId": {
          "type": "string",
          "default": "",
          "description": "GitLab Project ID (numeric or path/to/project)."
        },
        "codeReview.gitlab.username": {
          "type": "string",
          "default": "",
          "description": "GitLab username (for basic auth)."
        }
      }
    }
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.7.0",
    "@types/vscode": "^1.118.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "mocha": "^11.7.5",
    "typescript": "^5.9.3"
  }
}
